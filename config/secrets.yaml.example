# Copy to config/secrets.yaml (gitignored) and fill in. Never commit secrets.yaml.
# EYES_KEY in the environment overrides this file.

# Shared key for eye command authentication (docs/eye-protocol.md): exactly 64 hex characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Must match EYE_AUTH_KEY_HEX in firmware/eyes_esp32/include/secrets.h.
eye_key: "replace-with-64-hex-characters"
