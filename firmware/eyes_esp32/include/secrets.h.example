// Copy to secrets.h (gitignored) and fill in. Never commit secrets.h.
#ifndef EYES_ESP32_SECRETS_H
#define EYES_ESP32_SECRETS_H

#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"

// Shared key for eye command authentication (docs/eye-protocol.md): exactly 64 hex characters.
// Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
// Use the same value for eye_key in config/secrets.yaml (or EYES_KEY) on the brain.
// This placeholder is deliberately the wrong length, so the build fails until you replace it.
#define EYE_AUTH_KEY_HEX "replace-with-64-hex-characters"

#endif  // EYES_ESP32_SECRETS_H
